#version 460
// One ray per launch cell, from z = -1 toward +z through the cell's center in [-1, 1]^2; writes the
// payload (1 = hit, 2 = miss) into a bindless storage buffer.
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : require

layout(set = 0, binding = 3) buffer GfxStorageBuffer
{
    uint words[];
} gfx_storage_buffers[];
layout(set = 0, binding = 4) uniform accelerationStructureEXT gfx_acceleration_structures[];

layout(push_constant) uniform Push
{
    uint structure;
    uint results;
} push;

layout(location = 0) rayPayloadEXT uint payload;

void main()
{
    const uvec2 cell = gl_LaunchIDEXT.xy;
    const vec2 position = (vec2(cell) + 0.5) / vec2(gl_LaunchSizeEXT.xy) * 2.0 - 1.0;
    payload = 0;
    traceRayEXT(gfx_acceleration_structures[nonuniformEXT(push.structure)], gl_RayFlagsOpaqueEXT, 0xFF, 0, 0, 0,
                vec3(position, -1.0), 0.0, vec3(0.0, 0.0, 1.0), 10.0, 0);
    gfx_storage_buffers[nonuniformEXT(push.results)].words[cell.y * gl_LaunchSizeEXT.x + cell.x] = payload;
}
