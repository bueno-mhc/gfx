#version 460
// Workgroup size set by specialization constants (local_size_x_id); local_size_x gives its default.

layout(local_size_x = 16, local_size_y = 2, local_size_x_id = 0, local_size_y_id = 1) in;
layout(constant_id = 0) const uint GROUP_WIDTH = 16;
layout(constant_id = 1) const uint GROUP_HEIGHT = 2;

layout(set = 0, binding = 0) buffer Values
{
    uint values[];
};

void main()
{
    values[gl_GlobalInvocationID.x] = GROUP_WIDTH * GROUP_HEIGHT;
}
