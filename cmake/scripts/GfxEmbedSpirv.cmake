# ==============================================================================
# Generates the C++ module of gfx_add_shaders(): the SPIR-V words of every shader and a
# gfx::ShaderModuleDescription for each.
#
# Usage (from gfx_add_shaders):
#   cmake -DMANIFEST=<manifest.cmake> -DOUTPUT=<module.cppm> -DCONFIG=<build type> -P GfxEmbedSpirv.cmake
# ==============================================================================
cmake_minimum_required(VERSION 4.3)

include("${MANIFEST}")

# Debug builds carry what hot reload needs: source paths, definitions, include directories.
set(hot_reload FALSE)
if(CONFIG STREQUAL "Debug")
    set(hot_reload TRUE)
endif()

# _gfx_string_literal(<variable> <text>): <text> as a C++ string literal.
function(_gfx_string_literal variable text)
    string(REPLACE "\\" "\\\\" text "${text}")
    string(REPLACE "\"" "\\\"" text "${text}")
    set(${variable} "\"${text}\"" PARENT_SCOPE)
endfunction()

set(content "// Generated by gfx_add_shaders() for target ${GFX_SHADER_TARGET} (${CONFIG}). Do not edit.\n")
string(APPEND content "/// @file\n/// @brief Module ${GFX_SHADER_MODULE}: the SPIR-V of the shaders of ${GFX_SHADER_TARGET}.\n")
string(APPEND content "export module ${GFX_SHADER_MODULE};\n\nimport std;\nimport gfx;\n\nexport namespace ${GFX_SHADER_NAMESPACE}\n{\n\n")

# Definitions and include directories shared by every shader (used by hot reload).
set(defines_reference "{}")
set(include_directories_reference "{}")
if(hot_reload AND GFX_SHADER_DEFINES)
    list(LENGTH GFX_SHADER_DEFINES count)
    string(APPEND content "/// @brief Definitions the shaders were compiled with.\n")
    string(APPEND content "inline constexpr std::array<gfx::ShaderDefine, ${count}> shader_defines{{\n")
    foreach(definition IN LISTS GFX_SHADER_DEFINES)
        if(definition MATCHES "^([^=]+)=(.*)$")
            _gfx_string_literal(name "${CMAKE_MATCH_1}")
            _gfx_string_literal(value "${CMAKE_MATCH_2}")
        else()
            _gfx_string_literal(name "${definition}")
            set(value "\"\"")
        endif()
        string(APPEND content "    {.name = ${name}, .value = ${value}},\n")
    endforeach()
    string(APPEND content "}};\n\n")
    set(defines_reference "shader_defines")
endif()
if(hot_reload AND GFX_SHADER_INCLUDE_DIRECTORIES)
    list(LENGTH GFX_SHADER_INCLUDE_DIRECTORIES count)
    string(APPEND content "/// @brief Directories the shaders' #include directives searched.\n")
    string(APPEND content "inline constexpr std::array<std::string_view, ${count}> shader_include_directories{\n")
    foreach(directory IN LISTS GFX_SHADER_INCLUDE_DIRECTORIES)
        _gfx_string_literal(literal "${directory}")
        string(APPEND content "    ${literal},\n")
    endforeach()
    string(APPEND content "};\n\n")
    set(include_directories_reference "shader_include_directories")
endif()

foreach(identifier IN LISTS GFX_SHADER_IDENTIFIERS)
    set(spirv_file "${GFX_SHADER_${identifier}_SPIRV}")
    file(READ "${spirv_file}" bytes HEX)
    string(LENGTH "${bytes}" length)
    math(EXPR remainder "${length} % 8")
    if(length EQUAL 0 OR NOT remainder EQUAL 0)
        message(FATAL_ERROR "gfx_add_shaders: ${spirv_file} is not SPIR-V (its size is not a multiple of 4 bytes).")
    endif()

    # Little-endian bytes -> 32-bit words, 8 per line.
    string(REGEX MATCHALL "........" words "${bytes}")
    list(LENGTH words word_count)
    set(lines "")
    set(line "   ")
    set(column 0)
    foreach(word IN LISTS words)
        string(SUBSTRING "${word}" 0 2 b0)
        string(SUBSTRING "${word}" 2 2 b1)
        string(SUBSTRING "${word}" 4 2 b2)
        string(SUBSTRING "${word}" 6 2 b3)
        string(APPEND line " 0x${b3}${b2}${b1}${b0},")
        math(EXPR column "${column} + 1")
        if(column EQUAL 8)
            string(APPEND lines "${line}\n")
            set(line "   ")
            set(column 0)
        endif()
    endforeach()
    if(NOT column EQUAL 0)
        string(APPEND lines "${line}\n")
    endif()

    _gfx_string_literal(name "${GFX_SHADER_${identifier}_NAME}")
    _gfx_string_literal(entry_point "${GFX_SHADER_${identifier}_ENTRY_POINT}")
    set(source_path "{}")
    if(hot_reload)
        _gfx_string_literal(source_path "${GFX_SHADER_${identifier}_SOURCE}")
    endif()

    string(APPEND content "/// @brief SPIR-V of ${GFX_SHADER_${identifier}_NAME}.\n")
    string(APPEND content "inline constexpr std::array<std::uint32_t, ${word_count}> ${identifier}_spirv{\n${lines}};\n\n")
    string(APPEND content "/// @brief Description of a ShaderModule running ${GFX_SHADER_${identifier}_NAME}")
    if(hot_reload)
        string(APPEND content " (reloaded from its source when it changes)")
    endif()
    string(APPEND content ".\ninline constexpr gfx::ShaderModuleDescription ${identifier}{\n")
    string(APPEND content "    .stage = gfx::ShaderStage::${GFX_SHADER_${identifier}_STAGE},\n")
    string(APPEND content "    .source_format = gfx::ShaderSourceFormat::SPIRV,\n")
    string(APPEND content "    .spirv = ${identifier}_spirv,\n")
    string(APPEND content "    .source = {},\n")
    string(APPEND content "    .source_path = ${source_path},\n")
    string(APPEND content "    .entry_point = ${entry_point},\n")
    string(APPEND content "    .defines = ${defines_reference},\n")
    string(APPEND content "    .include_directories = ${include_directories_reference},\n")
    string(APPEND content "    .name = ${name},\n")
    string(APPEND content "};\n\n")
endforeach()

string(APPEND content "} // namespace ${GFX_SHADER_NAMESPACE}\n")
file(WRITE "${OUTPUT}" "${content}")
