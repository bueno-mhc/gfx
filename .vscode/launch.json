{
    // Debug configurations for the gfx tests and the windowed example: Debug build (build/debug), gdb from MSYS2 UCRT64.
    // Both build first and stop in the debugger at the first failed assertion (GTEST_BREAK_ON_FAILURE);
    // when that happens, select the test's own frame in the CALL STACK view.
    "version": "0.2.0",
    "configurations": [
        {
            // Run and Debug view: select this configuration and press the green Run button (or F5).
            // Asks for a test executable, then for the test(s) to run: Suite.Test for one test,
            // Suite.* for a suite, * for every test of the executable. Needs only the C/C++ extension.
            "name": "gfx: Debug Test",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/tests/${input:testExecutable}",
            "args": ["--gtest_filter=${input:googleTestFilter}"],
            "cwd": "${workspaceFolder}/build/debug",
            "environment": [
                { "name": "GTEST_BREAK_ON_FAILURE", "value": "1" }
            ],
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "gfx: Build Debug"
        },
        {
            // Used by the Testing panel's "Debug Test" button (see settings.json); requires CMake Tools
            // with the "debug" configure preset selected. CMake Tools replaces the ${cmake.test*}
            // placeholders with the chosen test's command line: <executable> --gtest_filter=<Suite.Test>.
            "name": "gfx: Debug Test (CMake Tools Testing panel)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${cmake.testProgram}",
            "args": ["${cmake.testArgs}"],
            "cwd": "${cmake.testWorkingDirectory}",
            "environment": [
                { "name": "GTEST_BREAK_ON_FAILURE", "value": "1" }
            ],
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "gfx: Build Debug"
        },
        {
            // The windowed example (examples/windowed), with the Vulkan validation layers. Asks for the
            // platform backend; close the window (or press Escape, then Return) to end it.
            "name": "gfx: Windowed example",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/examples/windowed/gfx_windowed_example.exe",
            "args": ["--backend", "${input:platformBackend}", "--validation"],
            "cwd": "${workspaceFolder}/build/debug",
            "environment": [
                { "name": "VK_ADD_LAYER_PATH", "value": "C:/msys64/ucrt64/bin" }
            ],
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "gfx: Build Debug"
        },
        {
            // The UI editor example (examples/ui_editor), with the Vulkan validation layers; its layout is
            // loaded from and saved (Control+S) to build/debug/editor_layout.json. Asks for the platform
            // backend; close the window (or Control+Q) to end it. To find an allocation reported after the
            // warm-up, add "--sweep", "--check-allocations" and break on counted_allocation().
            "name": "gfx: UI editor example",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/examples/ui_editor/gfx_ui_editor_example.exe",
            "args": ["--backend", "${input:platformBackend}", "--validation", "--layout", "editor_layout.json"],
            "cwd": "${workspaceFolder}/build/debug",
            "environment": [
                { "name": "VK_ADD_LAYER_PATH", "value": "C:/msys64/ucrt64/bin" }
            ],
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "gfx: Build Debug"
        },
        {
            // The physics sandbox (examples/physics_sandbox), with the Vulkan validation layers: a physics world drawn
            // with Vulkan under an orbit camera (right drag orbits, middle drag pans, the wheel zooms; Escape quits).
            // Asks for the platform backend and the physics backend.
            "name": "gfx: Physics sandbox",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/examples/physics_sandbox/gfx_physics_sandbox.exe",
            "args": ["--backend", "${input:platformBackend}", "--physics", "${input:physicsBackend}", "--validation"],
            "cwd": "${workspaceFolder}/build/debug",
            "environment": [
                { "name": "VK_ADD_LAYER_PATH", "value": "C:/msys64/ucrt64/bin" }
            ],
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "gfx: Build Debug"
        },
        {
            // The physics example (examples/physics): a headless scene stepped for four seconds, then checked
            // (each check printed; the exit code is 1 when one fails). Asks for the physics backend.
            "name": "gfx: Physics example",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/examples/physics/gfx_physics_example.exe",
            "args": ["--backend", "${input:physicsBackend}", "--steps", "240", "--threads", "4"],
            "cwd": "${workspaceFolder}/build/debug",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "gfx: Build Debug"
        }
    ],
    "inputs": [
        {
            "id": "platformBackend",
            "type": "pickString",
            "description": "Platform backend of the example",
            "options": ["sdl3", "glfw"],
            "default": "sdl3"
        },
        {
            "id": "physicsBackend",
            "type": "pickString",
            "description": "Physics backend of the example",
            "options": ["box3d", "reference"],
            "default": "box3d"
        },
        {
            "id": "testExecutable",
            "type": "pickString",
            "description": "Test executable to debug",
            "options": [
                { "label": "core       - EnumerationTest.*, IdentifierTest.*, BackendIdentityTest.*, NativeWindowHandleTest.*, MathTest.*", "value": "core/gfx_core_tests.exe" },
                { "label": "slot table - SlotTableTest.*", "value": "core/slot_table/gfx_slot_table_tests.exe" },
                { "label": "enums      - EnumsTest.*", "value": "graphics/enums/gfx_enums_tests.exe" },
                { "label": "errors     - ErrorsTest.*", "value": "graphics/errors/gfx_errors_tests.exe" },
                { "label": "handles    - HandlesTest.*", "value": "graphics/handles/gfx_handles_tests.exe" },
                { "label": "interface  - RecorderTest.*, DeviceTest.*, BindlessTest.*, PipelineValidationTest.*, FrameResourcesTest.*, FrameCommandPoolsTest.*, ...", "value": "graphics/interface/gfx_interface_tests.exe" },
                { "label": "shader layout - ShaderValidationTest.*, PipelineLayoutDefinitionTest.*, ShaderModuleDescriptionTest.*", "value": "graphics/shader_layout/gfx_shader_layout_tests.exe" },
                { "label": "windows headers - PlatformHeadersTest.*", "value": "graphics/windows_headers/gfx_windows_headers_tests.exe" },
                { "label": "backend factory - BackendFactoryTest.*", "value": "graphics/backend_factory/gfx_backend_factory_tests.exe" },
                { "label": "shader tools - SpirvReflectionTest.*, ShaderCompilerTest.*, ShaderCompilerDebugTest.*, GfxAddShadersTest.*", "value": "graphics/shader_tools/gfx_shader_tools_tests.exe" },
                { "label": "vulkan     - Vulkan*Test.* (real GPU; GFX_TEST_PHYSICAL_DEVICE=<index> picks the GPU)", "value": "graphics/vulkan/gfx_vulkan_tests.exe" },
                { "label": "vulkan allocation - Vulkan*AllocationTest.* (counts operator new while commands are recorded and submitted; real GPU)", "value": "graphics/vulkan/gfx_vulkan_allocation_tests.exe" },
                { "label": "platform   - PlatformTest.*, WindowTest.*, EventTest.*, EventQueueTest.*, ImageTest.*, InputSystemTest.*, BindingStorageTest.*, ...", "value": "platform/gfx_platform_tests.exe" },
                { "label": "backends   - Backends/PlatformBackendTest.* (every platform backend, real windows)", "value": "platform/backends/gfx_platform_backend_tests.exe" },
                { "label": "sdl3       - Sdl3PlatformTest.*, Sdl3EventsTest.*, Sdl3GamepadTest.* (SDL3 backend)", "value": "platform/backends/sdl3/gfx_platform_sdl3_tests.exe" },
                { "label": "glfw       - GlfwPlatformTest.*, GlfwEventsTest.* (GLFW backend)", "value": "platform/backends/glfw/gfx_platform_glfw_tests.exe" },
                { "label": "present    - Presentation/PresentationTest.* (visible windows x GPUs, Vulkan presentation)", "value": "platform_graphics/gfx_presentation_tests.exe" },
                { "label": "ui         - UiEnumerationsTest.*, UiHandlesTest.*, UiErrorsTest.*", "value": "ui/gfx_ui_tests.exe" },
                { "label": "font libraries - FreeTypeTest.*, HarfBuzzTest.*, MsdfAtlasGenTest.*, ... (third-party font pipeline)", "value": "ui/gfx_ui_font_library_tests.exe" },
                { "label": "atlas tools - AtlasFormatTest.*, AtlasViewTest.*, FontDecoderTest.*, SdfGeneratorTest.*, AtlasPackerTest.*, AtlasBuilderTest.*, ...", "value": "ui/gfx_ui_atlas_tools_tests.exe" },
                { "label": "atlas embed - AtlasEmbedTest.* (atlases built by gfx_add_ui_atlas and embedded)", "value": "ui/gfx_ui_atlas_embed_tests.exe" },
                { "label": "text       - FontAtlasTest.*, FontLibraryTest.*, TextLayoutTest.*, TextLayoutCacheTest.*", "value": "ui/gfx_ui_text_tests.exe" },
                { "label": "text allocation - TextAllocationTest.* (counts operator new: layouts, draw lists)", "value": "ui/gfx_ui_text_allocation_tests.exe" },
                { "label": "draw       - ColorTest.*, DrawListTest.*, DebugOverlayTest.*, Gpu/UiRendererTest.* (renderer on every GPU)", "value": "ui/gfx_ui_draw_tests.exe" },
                { "label": "context    - UiWindowTest.*, UiLayoutTest.*, UiWidgetTest.*, UiKeyboardTest.*, UiReportTest.*, ... (immediate mode, synthetic input)", "value": "ui/gfx_ui_context_tests.exe" },
                { "label": "ui platform - Backends/UiPlatformInputTest.*, Backends/UiWindowTest.* (platform adapter, visible windows)", "value": "ui/gfx_ui_platform_tests.exe" },
                { "label": "physics    - PhysicsEnumerationsTest.*, PhysicsHandlesTest.*, PhysicsErrorsTest.*, PrimitivesTest.*, IntersectionTest.*, BatchTest.*", "value": "physics/gfx_physics_common_tests.exe" },
                { "label": "camera     - CameraProjectionTest.*, CameraTest.*, CameraControllerTest.*", "value": "physics/gfx_camera_tests.exe" },
                { "label": "physics shapes - ShapeTest.*, GjkEpaTest.*, ContactTest.*, CollideTest.*, ManifoldCacheTest.*, ShapeQueryTest.*, SpatialStructureTest*, BroadPhaseTest.*, TaskSchedulerTest.*, DebugDrawTest.*", "value": "physics/gfx_physics_tests.exe" },
                { "label": "physics world - PhysicsInterfaceTest.*, PhysicsFactoryTest.*, NullBackendTest.*, SteppedWorldTest.*", "value": "physics/gfx_physics_world_tests.exe" },
                { "label": "physics dynamics - IntegratorTest.*, SoftBodyPresetTest.*, SoftBodyModelTest.*, XpbdSolverTest.*, JointRowsTest.*, SequentialImpulseSolverTest.*", "value": "physics/gfx_physics_dynamics_tests.exe" },
                { "label": "physics reference - ReferenceTest.*", "value": "physics/gfx_physics_reference_tests.exe" },
                { "label": "physics Box3D - Box3dTest.*, Box3dSoftBodyTest.*", "value": "physics/gfx_physics_box3d_tests.exe" },
                { "label": "toolchain  - ToolchainTest.*", "value": "toolchain/gfx_toolchain_tests.exe" }
            ],
            "default": "graphics/handles/gfx_handles_tests.exe"
        },
        {
            "id": "googleTestFilter",
            "type": "promptString",
            "description": "Test(s) to run: Suite.Test (e.g. HandlesTest.DefaultHandleIsNull), Suite.* or * (all)",
            "default": "*"
        }
    ]
}
