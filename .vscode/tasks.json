{
    // Build and test tasks for gfx. They use the "debug" presets of CMakePresets.json, so every task
    // works on the same build tree (build/debug) as CMake Tools and the debug configurations. The
    // presets put MSYS2's toolchain on PATH themselves.
    "version": "2.0.0",
    "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": true
    },
    "tasks": [
        {
            // Needed once, before the first build (CMake Tools also configures when the folder opens).
            "label": "gfx: Configure Debug",
            "type": "process",
            "command": "cmake",
            "args": ["--preset", "debug"],
            "problemMatcher": []
        },
        {
            // Builds without reconfiguring explicitly (CMake reconfigures by itself when a CMakeLists
            // changes), so it never disturbs CMake Tools while it uses the same build tree.
            "label": "gfx: Build Debug",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "--preset", "debug"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": { "base": "$gcc", "fileLocation": ["autoDetect", "${workspaceFolder}"] }
        },
        {
            "label": "gfx: Rebuild Debug (clean first)",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "--preset", "debug", "--clean-first"],
            "group": "build",
            "problemMatcher": { "base": "$gcc", "fileLocation": ["autoDetect", "${workspaceFolder}"] }
        },
        {
            // Every test, in parallel (compilation tests run one at a time among themselves).
            "label": "gfx: Run All Tests (Debug)",
            "type": "process",
            "command": "ctest",
            "args": ["--preset", "debug"],
            "dependsOn": "gfx: Build Debug",
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": []
        },
        {
            // Runs the tests whose name matches a regular expression, without the debugger.
            // Also covers the CompilationFailure.* and CompilationCheck.* tests, which cannot be debugged.
            "label": "gfx: Run One Test (Debug)",
            "type": "process",
            "command": "ctest",
            "args": ["--preset", "debug", "--tests-regex", "${input:testNamePattern}"],
            "dependsOn": "gfx: Build Debug",
            "group": "test",
            "problemMatcher": []
        },
        {
            // Prints every test name, e.g. to copy one into a debug configuration or "Run One Test".
            "label": "gfx: List Tests (Debug)",
            "type": "process",
            "command": "ctest",
            "args": ["--preset", "debug", "--show-only"],
            "dependsOn": "gfx: Build Debug",
            "group": "test",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "testNamePattern",
            "type": "promptString",
            "description": "Regular expression on test names, e.g. ^HandlesTest\\.DefaultHandleIsNull$ or HandlesTest or CompilationFailure",
            "default": "HandlesTest"
        }
    ]
}
