#version 460
// An iteration of the contact constraints' position projection for one color (or the overflow set), one invocation per
// constraint (Müller et al. 2020, §3.5; XPBD, Macklin et al. 2016). Every point of the manifold first, then every point again:
//   - non-penetration: C = the separation along the normal of the points on the surfaces (over the cores' anchors); the
//     overlap the point started the step with is undone at most maximum_push_speed · h at a time (depenetration bounded),
//     overlap the step's motion made is undone at once; Δλ = (−C − α̃λ) / (w + α̃), λ kept ≥ 0, with the contact's
//     compliance from contact_hertz (k = m_eff ω², α̃ = w / (ω h)²; 0 Hz: rigid) for a point that started the step touching or
//     within LINEAR_SLOP, rigid for one that started farther apart (a speculative contact: its bodies approach until they
//     touch, as the reference backend's and Box3D's do; against a 30 Hz contact a ball at 150 m/s would sink 0.8 m, through
//     a thin wall). contact_damping_ratio is not used: the velocity pass sets each contact's normal
//     speed (restitution), which is the damping these contacts need — XPBD's damping term (γ = 2ζ / (ω h), 25 for the
//     default ratio 10) left so little of each correction that columns of boxes leaned over and piles sank;
//   - static friction at the points that push: the friction anchors' tangential drift corrected to zero (α = 0) as long
//     as the manifold's tangential multipliers stay within μs times its whole push (Coulomb's cone over the contact patch:
//     a face's first point removes the whole body's drift, which its share of the push alone could not hold); beyond, the
//     point slips (its friction anchors are renewed next step) and dynamic friction acts in the velocity pass.
// The multipliers reset at the substep's first iteration (mode bit 0). Colored constraints write their bodies at once (no
// two of a color share one); the overflow set (mode bit 1) writes each side's correction for the Jacobi gather, computed
// with the sides' parts (split_node()).
#extension GL_GOOGLE_include_directive : require
#include "solver.glsl"

layout(constant_id = 67) const float LINEAR_SLOP = 0.0;

const float PI = 3.14159265358979;

void main()
{
    const uint key = push.argument;
    const uint index = gl_GlobalInvocationID.x;
    if (index >= color_count(key))
    {
        return;
    }
    const uint constraint = color_constraint(key, index);
    const uint slot = constraint - SOLVER.joint_count;
    const uint base = contact_base(slot);
    const uvec4 header = gpu_word_vectors[SOLVER.contacts].values[base];
    if ((header.w & CONTACT_ACTIVE) == 0U)
    {
        return;
    }
    Body first = load_body(header.x);
    Body second = load_body(header.y);
    float first_weight = 1.0;
    float second_weight = 1.0;
    if ((push.mode & 2U) != 0U)
    {
        // Each side's part, against the other's unsplit inverse mass; their corrections weighted for the gather.
        const float first_inverse_mass = scalar_inverse_mass(first);
        const float second_inverse_mass = scalar_inverse_mass(second);
        first_weight = split_node(first, header.x, second_inverse_mass, false);
        second_weight = split_node(second, header.y, first_inverse_mass, false);
    }
    const vec3 first_center = first.center;
    const vec3 first_rotation = first.rotation;
    const vec3 second_center = second.center;
    const vec3 second_rotation = second.rotation;
    const vec3 normal = gpu_vectors[SOLVER.contacts].values[base + 1U].xyz;
    const float static_friction = gpu_vectors[SOLVER.contacts].values[base + 2U].x;
    const bool reset = (push.mode & 1U) != 0U;
    vec4 normal_multipliers = reset ? vec4(0.0) : gpu_vectors[SOLVER.multipliers].values[4U * slot];
    vec4 friction_multipliers = reset ? vec4(0.0) : gpu_vectors[SOLVER.multipliers].values[4U * slot + 1U];

    // The contact's softness.
    const float h = PARAMETERS.gravity.w;
    const float omega_h = 2.0 * PI * SOLVER.contact_hertz * h;
    const float compliance_factor = SOLVER.contact_hertz > 0.0 ? 1.0 / (omega_h * omega_h) : 0.0;

    for (uint point = 0U; point < header.z; ++point)
    {
        // Non-penetration, at the points on the surfaces over the cores' anchors: the start's overlap undone at the
        // bounded speed, the step's new overlap at once.
        vec3 lever_first;
        vec3 lever_second;
        contact_levers(base, point, first, second, normal, lever_first, lever_second);
        const float separation = dot((second.center + lever_second) - (first.center + lever_first), normal);
        const float inverse_mass = generalized_inverse_mass(first, lever_first, normal) + generalized_inverse_mass(second, lever_second, normal);
        if (inverse_mass > 0.0)
        {
            const float start_separation = gpu_vectors[SOLVER.contacts].values[base + 3U + 4U * point].w;
            const float compliance = start_separation > LINEAR_SLOP ? 0.0 : inverse_mass * compliance_factor;
            const float initial = max(-start_separation, 0.0);
            const float penetration = -separation;
            const float pushed = penetration <= initial ? min(penetration, SOLVER.maximum_push_speed * h)
                                                        : penetration - initial + min(initial, SOLVER.maximum_push_speed * h);
            const float bounded = penetration > 0.0 ? -pushed : separation;
            const float delta = (-bounded - compliance * normal_multipliers[point]) / (inverse_mass + compliance);
            const float multiplier = max(normal_multipliers[point] + delta, 0.0);
            const float applied = multiplier - normal_multipliers[point];
            normal_multipliers[point] = multiplier;
            if (applied != 0.0)
            {
                correct_position(second, lever_second, applied * normal);
                correct_position(first, lever_first, -applied * normal);
            }
        }
    }

    // Static friction at the friction anchors of the points that push, within μs times the manifold's whole push.
    const float patch_push = normal_multipliers.x + normal_multipliers.y + normal_multipliers.z + normal_multipliers.w;
    for (uint point = 0U; point < header.z; ++point)
    {
        const uint anchors = base + 3U + 4U * point;
        if (normal_multipliers[point] <= 0.0 || static_friction <= 0.0)
        {
            continue;
        }
        const vec4 friction_first = gpu_vectors[SOLVER.contacts].values[anchors + 2U];
        const vec4 friction_second = gpu_vectors[SOLVER.contacts].values[anchors + 3U];
        const vec3 held_first = first.center + rotate_by(first.orientation, friction_first.xyz);
        const vec3 held_second = second.center + rotate_by(second.orientation, friction_second.xyz);
        const vec3 drift = held_second - held_first;
        const vec3 tangential = drift - normal * dot(drift, normal);
        const float length_tangential = length(tangential);
        if (length_tangential <= 1e-7)
        {
            continue;
        }
        const vec3 tangent = tangential / length_tangential;
        const vec3 friction_lever_first = held_first - first.center;
        const vec3 friction_lever_second = held_second - second.center;
        const float tangential_mass = generalized_inverse_mass(first, friction_lever_first, tangent) + generalized_inverse_mass(second, friction_lever_second, tangent);
        if (tangential_mass <= 0.0)
        {
            continue;
        }
        const float delta = -length_tangential / tangential_mass;
        const vec4 held = abs(friction_multipliers);
        const float patch_held = held.x + held.y + held.z + held.w - held[point] + abs(friction_multipliers[point] + delta);
        if (patch_held <= static_friction * patch_push)
        {
            friction_multipliers[point] += delta;
            correct_position(second, friction_lever_second, delta * tangent);
            correct_position(first, friction_lever_first, -delta * tangent);
        }
        else
        {
            gpu_vectors[SOLVER.contacts].values[anchors + 2U].w = 1.0;
        }
    }

    gpu_vectors[SOLVER.multipliers].values[4U * slot] = normal_multipliers;
    gpu_vectors[SOLVER.multipliers].values[4U * slot + 1U] = friction_multipliers;
    if ((header.w & CONTACT_PUSHED) == 0U && any(greaterThan(normal_multipliers, vec4(0.0))))
    {
        gpu_word_vectors[SOLVER.contacts].values[base].w = header.w | CONTACT_PUSHED;
    }
    if ((push.mode & 2U) != 0U)
    {
        gpu_vectors[SOLVER.corrections].values[4U * constraint] = vec4((first.center - first_center) * first_weight, 0.0);
        gpu_vectors[SOLVER.corrections].values[4U * constraint + 1U] = vec4((first.rotation - first_rotation) * first_weight, 0.0);
        gpu_vectors[SOLVER.corrections].values[4U * constraint + 2U] = vec4((second.center - second_center) * second_weight, 0.0);
        gpu_vectors[SOLVER.corrections].values[4U * constraint + 3U] = vec4((second.rotation - second_rotation) * second_weight, 0.0);
        return;
    }
    store_body_pose(header.x, first);
    store_body_pose(header.y, second);
}
