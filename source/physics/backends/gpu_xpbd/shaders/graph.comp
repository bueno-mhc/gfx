#version 460
// The body-to-constraint graph's entries (two per constraint: joints, then manifold slots): a constraint in use whose
// side's body moves through constraints (awake and dynamic) is keyed by that body, its value the constraint × 2 + the
// side; other entries are keyed 0xFFFFFFFF (they sort last and form no range). Sorted stably by key, the entries of a
// body are its constraints in order: what the coloring's neighbors and the Jacobi gathers read.
#extension GL_GOOGLE_include_directive : require
#include "solver.glsl"

void main()
{
    const uint constraint = gl_GlobalInvocationID.x;
    if (constraint >= constraint_count())
    {
        return;
    }
    const Constraint loaded = load_constraint(constraint);
    for (uint side = 0U; side < 2U; ++side)
    {
        const uint body = side == 0U ? loaded.first : loaded.second;
        const bool keyed = loaded.in_use && body_is_dynamic_awake(body_flags_of(body));
        gpu_words[SOLVER.graph_keys].words[2U * constraint + side] = keyed ? body : 0xFFFFFFFFU;
        gpu_words[SOLVER.graph_values].words[2U * constraint + side] = 2U * constraint + side;
    }
}
