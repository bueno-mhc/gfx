#version 460
// A contact constraint per manifold slot of the step (GpuContact): its bodies (the colliders' bodies), its normal, its
// materials (friction as the geometric mean of the colliders', rolling resistance and restitution as the larger, as the
// reference backend mixes them), the shapes' margins where they touch (a convex shape's own, a compound child's, none for
// triangles: the reference backend's contact_margin()), per point the anchors on both bodies' cores (the point less and
// plus half its separation along the normal, and further in by the margin, relative to the centers of mass, in the body
// frames: a spinning ball's point stays under it) and the friction anchors — the matched point's of the previous step when
// static friction held it there (the contact cache found it), else the points on the surfaces (material points: a ball
// rolling without slipping is not held back). With mode 1 (the
// collider lists changed: instance indices name other colliders) no previous anchor is used. A particle's contacts have no
// restitution nor rolling resistance, and two particles of a soft body none of their friction (the abstraction's soft-body
// solver has none). A contact is flagged touching when a point overlaps at the step's start or could within the step: its
// gap closed at the sum of the two points' speeds and gravity's pull (not their approach speed: a body stopped by another
// contact meets what was falling along with it). The speculative margin is the farthest motion of any body, so most of a
// pile's candidates keep a gap; the Jacobi gather splits the nodes among their touching contacts only.
#extension GL_GOOGLE_include_directive : require
#include "solver.glsl"
#include "narrow_phase.glsl"

// The margin around the core of a collider's shape where the manifold's sub-shape touches it: a convex shape's own, a
// compound child's (none for a nested compound), none for the triangles of a mesh or a height field.
float contact_margin(uint shape, uint sub_shape)
{
    ShapeRecord record = load_record(shape);
    if (record.kind == SHAPE_COMPOUND)
    {
        if (sub_shape >= record.count)
        {
            return 0.0;
        }
        record = load_record(gpu_word_vectors[compound_children].values[2U * (record.first + sub_shape)].w);
        if (record.kind == SHAPE_COMPOUND)
        {
            return 0.0;
        }
    }
    return record.kind == SHAPE_TRIANGLE_MESH || record.kind == SHAPE_HEIGHT_FIELD ? 0.0 : record.margin;
}

void main()
{
    const uint slot = gl_GlobalInvocationID.x;
    const uint slots = min(count_word(COUNT_MANIFOLD_SLOTS), SOLVER.manifold_capacity);
    if (slot == 0U)
    {
        gpu_words[SOLVER.counts].words[COUNT_SLOTS] = slots;
        gpu_words[SOLVER.counts].words[COUNT_CONSTRAINTS] = SOLVER.joint_count + slots;
        gpu_words[SOLVER.counts].words[COUNT_GRAPH_ENTRIES] = 2U * (SOLVER.joint_count + slots);
    }
    if (slot >= slots)
    {
        return;
    }
    const uint base = contact_base(slot);
    const uvec4 header = gpu_word_vectors[SOLVER.manifolds].values[MANIFOLD_VECTORS * slot];
    if (header.z == 0U)
    {
        gpu_word_vectors[SOLVER.contacts].values[base] = uvec4(0U);
        return;
    }

    // The bodies and the mixed materials.
    const uint first_collider = instance_collider(header.x);
    const uint second_collider = instance_collider(header.y);
    const Collider first = load_collider(first_collider);
    const Collider second = load_collider(second_collider);
    const vec3 normal = gpu_vectors[SOLVER.manifolds].values[MANIFOLD_VECTORS * slot + 2U].xyz;
    const uvec2 sub_shapes = gpu_word_vectors[SOLVER.manifolds].values[MANIFOLD_VECTORS * slot + 1U].xy;
    const uint priority = hash_words(uvec4(first_collider, second_collider, sub_shapes));
    const bool particle = ((first.flags | second.flags) & COLLIDER_PARTICLE) != 0U;
    const float friction = (first.flags & second.flags & COLLIDER_PARTICLE) != 0U ? 0.0 : 1.0;
    const vec4 material = vec4(sqrt(first.material.x * second.material.x) * friction, sqrt(first.material.y * second.material.y) * friction,
                               particle ? 0.0 : max(first.material.z, second.material.z), uintBitsToFloat(priority));
    const uint points = min(header.z, 4U);
    gpu_vectors[SOLVER.contacts].values[base + 1U] = vec4(normal, particle ? 0.0 : max(first.material.w, second.material.w));
    gpu_vectors[SOLVER.contacts].values[base + 2U] = material;
    load_tables(SOLVER.tables);
    const float first_margin = contact_margin(first.shape, sub_shapes.x);
    const float second_margin = contact_margin(second.shape, sub_shapes.y);
    gpu_vectors[SOLVER.contacts].values[base + CONTACT_MARGINS] = vec4(first_margin, second_margin, 0.0, 0.0);

    // The anchors, and the friction anchors kept or new.
    const vec3 first_center = node_center(first.body);
    const vec4 first_orientation = node_orientation(first.body);
    const vec3 second_center = node_center(second.body);
    const vec4 second_orientation = node_orientation(second.body);
    const Body first_body = load_body(first.body);
    const Body second_body = load_body(second.body);
    const float step = PARAMETERS.gravity.w * float(PARAMETERS.substeps);
    const float pull = length(PARAMETERS.gravity.xyz) * step * step;
    bool touching = false;
    for (uint point = 0U; point < points; ++point)
    {
        const vec4 contact = gpu_vectors[SOLVER.manifolds].values[MANIFOLD_VECTORS * slot + 3U + 2U * point];
        const vec3 on_first = contact.xyz - normal * (0.5 * contact.w);
        const vec3 on_second = contact.xyz + normal * (0.5 * contact.w);
        const float closing = length(second_body.linear_velocity + cross(second_body.angular_velocity, on_second - second_center)) +
                              length(first_body.linear_velocity + cross(first_body.angular_velocity, on_first - first_center));
        touching = touching || contact.w - closing * step - pull <= 0.0;
        const vec3 relative = (second_body.linear_velocity + cross(second_body.angular_velocity, on_second - second_center)) -
                              (first_body.linear_velocity + cross(first_body.angular_velocity, on_first - first_center));
        const float approach = max(-dot(relative, normal), 0.0);
        const vec3 anchor_first = rotate_by(quaternion_conjugate(first_orientation), on_first - normal * first_margin - first_center);
        const vec3 anchor_second = rotate_by(quaternion_conjugate(second_orientation), on_second + normal * second_margin - second_center);
        vec4 friction_first = vec4(rotate_by(quaternion_conjugate(first_orientation), on_first - first_center), 0.0);
        vec4 friction_second = vec4(rotate_by(quaternion_conjugate(second_orientation), on_second - second_center), 0.0);
        const uint predecessor = push.mode == 0U ? gpu_words[SOLVER.predecessors].words[4U * slot + point] : 0xFFFFFFFFU;
        if (predecessor != 0xFFFFFFFFU)
        {
            const uint previous = contact_base(predecessor / 4U) + 3U + 4U * (predecessor % 4U);
            const vec4 kept_first = gpu_vectors[SOLVER.previous_contacts].values[previous + 2U];
            if (kept_first.w == 0.0)
            {
                friction_first = vec4(kept_first.xyz, 0.0);
                friction_second = vec4(gpu_vectors[SOLVER.previous_contacts].values[previous + 3U].xyz, 0.0);
            }
        }
        const uint anchors = base + 3U + 4U * point;
        gpu_vectors[SOLVER.contacts].values[anchors] = vec4(anchor_first, contact.w);
        gpu_vectors[SOLVER.contacts].values[anchors + 1U] = vec4(anchor_second, approach);
        gpu_vectors[SOLVER.contacts].values[anchors + 2U] = friction_first;
        gpu_vectors[SOLVER.contacts].values[anchors + 3U] = friction_second;
    }
    gpu_word_vectors[SOLVER.contacts].values[base] = uvec4(first.body, second.body, points, CONTACT_ACTIVE | (touching ? CONTACT_TOUCHING : 0U));
    atomicAdd(gpu_words[SOLVER.counts].words[COUNT_ACTIVE_CONSTRAINTS], 1U);
    atomicAdd(gpu_words[SOLVER.counts].words[COUNT_CONTACT_POINTS], points);
}
