#version 460
// The contact cache (GpuNarrowPhase::match): each point of each current manifold finds its predecessor — a point with the
// same feature (its sub-shapes and local features) among the previous manifolds of the same pair, the first of them in
// their order — by a binary search of the pair among the previous manifolds sorted by pair (stably: a pair's manifolds keep
// their order), then a comparison of the features. A predecessor is the previous manifold's index × 4 + its point, or
// INVALID_INDEX. Manifolds are GpuManifold: eleven vectors (header, sub-shapes, normal, four points of two vectors).
#extension GL_GOOGLE_include_directive : require
#include "primitives.glsl"

layout(push_constant) uniform Push
{
    uint previous_buffer;
    uint previous_first;
    uint sorted_firsts_buffer; // the previous manifolds' first instances, sorted by pair
    uint order_buffer;         // the previous manifolds' indices, sorted by pair
    uint previous_maximum;
    uint previous_count_buffer;
    uint previous_count_word;
    uint current_buffer;
    uint current_first;
    uint predecessors_buffer;
    uint predecessors_first;
    uint maximum;
    uint count_buffer;
    uint count_word;
} push;

const uint MANIFOLD_VECTORS = 11U;

uvec4 previous_header(uint manifold)
{
    return gpu_word_vectors[push.previous_buffer].values[MANIFOLD_VECTORS * (push.previous_first + manifold)];
}

uvec3 previous_feature(uint manifold, uint point)
{
    return gpu_word_vectors[push.previous_buffer].values[MANIFOLD_VECTORS * (push.previous_first + manifold) + 4U + 2U * point].xyz;
}

void main()
{
    const uint count = resolve_count(push.maximum, push.count_buffer, push.count_word);
    const uint index = gl_GlobalInvocationID.x;
    if (index >= count)
    {
        return;
    }
    const uint current = MANIFOLD_VECTORS * (push.current_first + index);
    const uvec4 header = gpu_word_vectors[push.current_buffer].values[current];
    uint predecessors[4] = uint[4](INVALID_INDEX, INVALID_INDEX, INVALID_INDEX, INVALID_INDEX);
    if (header.z > 0U)
    {
        // The first previous manifold whose pair is not before this one's.
        const uint previous_count = resolve_count(push.previous_maximum, push.previous_count_buffer, push.previous_count_word);
        uint low = 0U;
        uint high = previous_count;
        while (low < high)
        {
            const uint middle = low + (high - low) / 2U;
            const uint first = gpu_words[push.sorted_firsts_buffer].words[middle];
            const uvec4 candidate = previous_header(gpu_words[push.order_buffer].words[middle]);
            const uint second = candidate.z == 0U ? INVALID_INDEX : candidate.y;
            if (first < header.x || (first == header.x && second < header.y))
            {
                low = middle + 1U;
            }
            else
            {
                high = middle;
            }
        }

        // The points of the pair's manifolds with the same features.
        for (uint point = 0U; point < header.z && point < 4U; ++point)
        {
            const uvec3 feature = gpu_word_vectors[push.current_buffer].values[current + 4U + 2U * point].xyz;
            for (uint position = low; position < previous_count && predecessors[point] == INVALID_INDEX; ++position)
            {
                const uint manifold = gpu_words[push.order_buffer].words[position];
                const uvec4 found = previous_header(manifold);
                if (found.z == 0U || found.x != header.x || found.y != header.y)
                {
                    break;
                }
                for (uint other = 0U; other < found.z && other < 4U; ++other)
                {
                    if (all(equal(previous_feature(manifold, other), feature)))
                    {
                        predecessors[point] = manifold * 4U + other;
                        break;
                    }
                }
            }
        }
    }
    gpu_word_vectors[push.predecessors_buffer].values[push.predecessors_first + index] =
        uvec4(predecessors[0], predecessors[1], predecessors[2], predecessors[3]);
}
