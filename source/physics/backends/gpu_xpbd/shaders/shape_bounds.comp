#version 460
// The box around each instance's shape at its pose (GpuNarrowPhase::bounds), as Shape::bounds(pose): a convex shape's from
// its support function along each world axis plus its margin, the others' own box moved; grown by the expansion asked for.
#extension GL_GOOGLE_include_directive : require
#include "narrow_phase.glsl"

layout(push_constant) uniform Push
{
    uint tables;
    uint instances_buffer;
    uint instances_first;
    uint boxes_buffer;
    uint boxes_first;
    uint maximum;
    uint count_buffer;
    uint count_word;
    float expansion;
} push;

void main()
{
    const uint count = resolve_count(push.maximum, push.count_buffer, push.count_word);
    const uint index = gl_GlobalInvocationID.x;
    if (index >= count)
    {
        return;
    }
    load_tables(push.tables);
    uint shape;
    const Pose pose = load_instance(push.instances_buffer, push.instances_first + index, shape);
    const Aabb box = expanded(shape_bounds_at(load_record(shape), pose), push.expansion);
    const uint base = 2U * (push.boxes_first + index);
    gpu_vectors[push.boxes_buffer].values[base] = vec4(box.minimum, 0.0);
    gpu_vectors[push.boxes_buffer].values[base + 1U] = vec4(box.maximum, 0.0);
}
