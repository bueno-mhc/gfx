#version 460
// Islands of a step: dynamic bodies joined by contact constraints and joints, by label propagation (each label the
// smallest body index of its island, whatever the order the edges are hooked in: deterministic once converged). Particles
// are in no island (soft bodies never sleep): a body touching or holding one is kept awake. Modes:
//   0 (bodies)       labels to themselves (dynamic bodies), island flags cleared, island timers to +inf;
//   1 (constraints)  hook: the roots of an edge's two bodies, the larger one pointed at the smaller (atomic minimum);
//                    with argument 1, the changes counted (the last round: none left means converged);
//   2 (bodies)       pointer jumping: each label replaced by its root;
//   3 (bodies)       awake bodies mark their island awake;
//   4 (constraints)  a dynamic body touching or joined to a moving kinematic one, or a particle, marks its island awake
//                    and kept awake;
//   5 (bodies)       bodies asleep in an awake island wake up at rest (their sleep timer cleared).
#extension GL_GOOGLE_include_directive : require
#include "solver.glsl"

const uint ISLAND_AWAKE = 1U;
const uint ISLAND_KEPT_AWAKE = 2U;

bool is_dynamic(uint body)
{
    if (is_particle(body))
    {
        return false;
    }
    const uint flags = body_flags_of(body);
    return (flags & BODY_SIMULATED) != 0U && (flags & BODY_DYNAMIC) != 0U;
}

uint root_of(uint body)
{
    uint current = body;
    for (uint step = 0U; step < 64U; ++step)
    {
        const uint parent = gpu_words[SOLVER.labels].words[current];
        if (parent == current)
        {
            break;
        }
        current = parent;
    }
    return current;
}

bool moving_kinematic(uint body)
{
    if (is_particle(body))
    {
        return true;
    }
    const uint flags = body_flags_of(body);
    if ((flags & BODY_KINEMATIC) == 0U)
    {
        return false;
    }
    const vec3 linear = gpu_vectors[PARAMETERS.body_linear_velocities].values[body].xyz;
    const vec3 angular = gpu_vectors[PARAMETERS.body_angular_velocities].values[body].xyz;
    return any(notEqual(linear, vec3(0.0))) || any(notEqual(angular, vec3(0.0)));
}

void main()
{
    const uint index = gl_GlobalInvocationID.x;
    const bool per_constraint = push.mode == 1U || push.mode == 4U;
    if (per_constraint ? index >= constraint_count() : index >= SOLVER.body_count)
    {
        return;
    }
    if (push.mode == 0U)
    {
        gpu_words[SOLVER.labels].words[index] = is_dynamic(index) ? index : 0xFFFFFFFFU;
        gpu_words[SOLVER.island_flags].words[index] = 0U;
        gpu_words[SOLVER.island_timers].words[index] = floatBitsToUint(infinity());
        return;
    }
    if (per_constraint)
    {
        const Constraint loaded = load_constraint(index);
        if (!loaded.in_use)
        {
            return;
        }
        const bool first_dynamic = is_dynamic(loaded.first);
        const bool second_dynamic = is_dynamic(loaded.second);
        if (push.mode == 1U)
        {
            if (!first_dynamic || !second_dynamic)
            {
                return;
            }
            const uint first = root_of(loaded.first);
            const uint second = root_of(loaded.second);
            if (first != second)
            {
                atomicMin(gpu_words[SOLVER.labels].words[max(first, second)], min(first, second));
                if (push.argument == 1U)
                {
                    atomicAdd(gpu_words[SOLVER.counts].words[COUNT_ISLAND_CHANGES], 1U);
                }
            }
            return;
        }
        if (first_dynamic && !second_dynamic && moving_kinematic(loaded.second))
        {
            atomicOr(gpu_words[SOLVER.island_flags].words[root_of(loaded.first)], ISLAND_AWAKE | ISLAND_KEPT_AWAKE);
        }
        if (second_dynamic && !first_dynamic && moving_kinematic(loaded.first))
        {
            atomicOr(gpu_words[SOLVER.island_flags].words[root_of(loaded.second)], ISLAND_AWAKE | ISLAND_KEPT_AWAKE);
        }
        return;
    }

    // Per body.
    if (!is_dynamic(index))
    {
        return;
    }
    if (push.mode == 2U)
    {
        gpu_words[SOLVER.labels].words[index] = root_of(index);
        return;
    }
    const uint flags = gpu_words[PARAMETERS.body_flags].words[index];
    const uint island = root_of(index);
    if (push.mode == 3U)
    {
        if ((flags & BODY_AWAKE) != 0U)
        {
            atomicOr(gpu_words[SOLVER.island_flags].words[island], ISLAND_AWAKE);
        }
        return;
    }
    if ((flags & BODY_AWAKE) == 0U && (gpu_words[SOLVER.island_flags].words[island] & ISLAND_AWAKE) != 0U)
    {
        gpu_words[PARAMETERS.body_flags].words[index] = flags | BODY_AWAKE;
        gpu_vectors[PARAMETERS.body_linear_velocities].values[index].xyz = vec3(0.0);
        gpu_vectors[PARAMETERS.body_angular_velocities].values[index].xyz = vec3(0.0);
        gpu_words[PARAMETERS.sleep_timers].words[index] = 0U;
    }
}
