/// @file frame_input.cppm
/// @brief gfx.ui.input: what a UI frame receives (UiFrameInput, a plain value: time, display size, mouse, keys,
///        text) and the platform services it asks for (UiPlatformServices: clipboard, cursor, text input, links),
///        with UiNullPlatformServices for contexts without a platform. gfx.ui.platform builds both from the gfx
///        platform library; any other windowing fills them itself.
export module gfx.ui.input;

import std;
import gfx.core.enums;
import gfx.core.types;
import gfx.ui.draw;

export namespace gfx::ui
{

/// @brief A mouse button pressed or released during a frame.
struct UiMouseButtonEvent
{
    MouseButton button = MouseButton::LEFT; ///< Button.
    bool down = false;                      ///< Pressed (true) or released.
    Vector2 position{};                     ///< Mouse position, UI units.
};

/// @brief A key pressed or released during a frame.
struct UiKeyEvent
{
    Key key = Key::UNKNOWN;              ///< Physical key.
    KeyCode key_code = KeyCode::UNKNOWN; ///< Symbol of the keyboard layout (shortcuts use it).
    bool down = false;                   ///< Pressed (true) or released.
    bool repeat = false;                 ///< Generated by key repeat (down only).
};

/// @brief Everything a frame of the UI receives. A plain value whose spans and views only need to live until
///        UiContext::begin_frame() returns. Positions and sizes are UI units: pixels divided by
///        pixels_per_unit, so a UI keeps its size on every display.
struct UiFrameInput
{
    double time = 0.0;                                     ///< Seconds on a monotonic clock (double clicks, key repeat).
    Vector2 display_size{};                                ///< Size of the area the UI covers, UI units.
    float pixels_per_unit = 1.0F;                          ///< Pixels of the target per UI unit (the window's content scale).
    bool focused = true;                                   ///< The window has the keyboard focus (false releases every key and button).
    bool mouse_present = false;                            ///< The mouse is over the area (mouse_position is meaningful).
    Vector2 mouse_position{};                              ///< Mouse position after the frame's events, UI units.
    std::span<const UiMouseButtonEvent> mouse_buttons{};   ///< Button events of the frame, in order.
    MouseButtonMask mouse_buttons_held = MouseButtonMask::NONE; ///< Buttons held after the events (corrects missed events).
    Vector2 mouse_wheel{};                                 ///< Wheel notches of the frame; +y away from the user (content moves down).
    std::span<const UiKeyEvent> keys{};                    ///< Key events of the frame, in order.
    KeyModifier modifiers = KeyModifier::NONE;             ///< Modifiers held after the events.
    std::string_view text{};                               ///< UTF-8 text typed during the frame (after IME composition).
    std::string_view composition{};                        ///< IME composition in progress (shown at the cursor, not yet typed).
    std::int32_t composition_cursor = 0;                   ///< Cursor in the composition, code points.
};

/// @brief What the UI asks of the platform: clipboard, cursor shape, text input (IME placement), opening links.
///        Implemented over gfx::platform by gfx.ui.platform, or by the application for its own windowing. Called
///        on the thread that runs the frames, from UiContext::end_frame() (cursor, text input) and from widgets
///        (clipboard); exceptions are caught and reported (UiFrameProblem::PLATFORM_SERVICE).
class UiPlatformServices
{
public:
    UiPlatformServices() = default;
    UiPlatformServices(const UiPlatformServices&) = delete;
    auto operator=(const UiPlatformServices&) -> UiPlatformServices& = delete;
    virtual ~UiPlatformServices() = default;

    /// @brief The clipboard's text (UTF-8; empty when there is none).
    [[nodiscard]] virtual auto clipboard_text() -> std::string = 0;

    /// @brief Puts @p text (UTF-8) on the clipboard.
    virtual void set_clipboard_text(std::string_view text) = 0;

    /// @brief Shows the mouse cursor as @p shape (called when the shape the UI wants changes).
    virtual void set_cursor(CursorShape shape) = 0;

    /// @brief Starts text input (IME, on-screen keyboards) for a field whose cursor is @p area (UI units), or stops
    ///        it when @p active is false (called when either changes). The field draws IME compositions itself
    ///        (UiFrameInput::composition).
    virtual void set_text_input(bool active,
                                const UiRectangle& area) = 0;

    /// @brief Opens @p url in the user's browser; false when it cannot.
    [[nodiscard]] virtual auto open_url(std::string_view url) -> bool = 0;
};

/// @brief Services of a context without a platform (tests, offscreen tools): the clipboard is kept in memory,
///        the cursor and text input requests are remembered, links never open.
class UiNullPlatformServices final : public UiPlatformServices
{
public:
    [[nodiscard]] auto clipboard_text() -> std::string override
    {
        return m_clipboard;
    }

    void set_clipboard_text(std::string_view text) override
    {
        m_clipboard.assign(text);
    }

    void set_cursor(CursorShape shape) override
    {
        m_cursor = shape;
    }

    void set_text_input(bool active,
                        const UiRectangle& area) override
    {
        m_text_input = active;
        m_text_input_area = area;
    }

    [[nodiscard]] auto open_url(std::string_view /*url*/) -> bool override
    {
        return false;
    }

    /// @brief The last cursor shape asked for.
    [[nodiscard]] auto cursor() const noexcept -> CursorShape
    {
        return m_cursor;
    }

    /// @brief Whether text input was last started.
    [[nodiscard]] auto is_text_input_active() const noexcept -> bool
    {
        return m_text_input;
    }

    /// @brief The area of the last text input started.
    [[nodiscard]] auto text_input_area() const noexcept -> UiRectangle
    {
        return m_text_input_area;
    }

private:
    std::string m_clipboard{};
    CursorShape m_cursor = CursorShape::ARROW;
    bool m_text_input = false;
    UiRectangle m_text_input_area{};
};

} // namespace gfx::ui
