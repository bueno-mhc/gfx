/// @file shader_module.cppm
/// @brief ShaderModule: compiled shader code together with the layout reflected from it.
///
/// Shader code reaches the library as SPIR-V. Release builds only accept SPIR-V compiled at build time
/// (gfx_add_shaders() in CMake, or any other compiler). Debug builds also accept GLSL source, compile
/// it at run time, and reload modules whose source file changed (Device::poll_shader_changes()).
export module gfx.interface:shader_module;

import std;
import gfx.enums;
import gfx.errors;
import gfx.handles;
import :backend_object;
import :shader_layout;

export namespace gfx
{

/// @brief How to create a ShaderModule.
struct ShaderModuleDescription
{
    ShaderStage stage = ShaderStage::NONE;                        ///< Stage the shader runs in.
    ShaderSourceFormat source_format = ShaderSourceFormat::SPIRV; ///< SPIR-V binary or GLSL source (Debug only).
    std::span<const std::uint32_t> spirv{};                       ///< SPIR-V words (ShaderSourceFormat::SPIRV).
    std::string_view glsl_source{};                               ///< GLSL source (ShaderSourceFormat::GLSL).
    std::string_view source_path{};                               ///< GLSL file the code comes from; Debug builds
                                                                  ///< reload the module when it changes (empty =
                                                                  ///< not reloadable).
    std::string_view entry_point = "main";                        ///< Entry point function.
    std::string_view name{};                                      ///< Name for messages (file name or debug name).
};

/// @brief Checks what a backend can check before compiling or reflecting anything: one stage, an entry
///        point, SPIR-V that starts with its magic number, and GLSL only in Debug builds. Backends call
///        it first in Device::create_shader_module().
/// @throws InvalidUsageError naming the problem.
void
validate_shader_module_description(const ShaderModuleDescription& description,
                                   std::optional<BackendKind> backend = std::nullopt)
{
    const auto reject = [&](std::string problem, std::string suggestion)
    {
        throw InvalidUsageError({
            .backend = backend,
            .operation = "Device::create_shader_module",
            .problem = std::format("shader '{}': {}", description.name, problem),
            .suggestion = std::move(suggestion),
        });
    };

    // Exactly one stage and an entry point.
    if (!std::has_single_bit(std::to_underlying(description.stage)))
    {
        reject(std::format("the stage must be exactly one shader stage, not {}", description.stage),
               "set ShaderModuleDescription::stage, e.g. ShaderStage::COMPUTE");
    }
    if (description.entry_point.empty())
    {
        reject("the entry point is empty", "set ShaderModuleDescription::entry_point (usually \"main\")");
    }

    // SPIR-V: non-empty and starting with the magic number.
    if (description.source_format == ShaderSourceFormat::SPIRV)
    {
        if (description.spirv.empty())
        {
            reject("no SPIR-V words were given", "pass the words generated by gfx_add_shaders() in ShaderModuleDescription::spirv");
        }
        if (description.spirv.front() != SPIRV_MAGIC_NUMBER)
        {
            reject(std::format("the code is not SPIR-V: its first word is {:#010x}, SPIR-V starts with {:#010x}",
                               description.spirv.front(), SPIRV_MAGIC_NUMBER),
                   "pass the contents of a .spv file as 32-bit words in their original byte order");
        }
        return;
    }

    // GLSL: compiled at run time in Debug builds only.
    if constexpr (!SHADER_HOT_RELOAD)
    {
        reject("GLSL source is compiled at run time only in Debug builds; this Release build only loads compiled SPIR-V",
               "compile the shader at build time with gfx_add_shaders() and pass its SPIR-V");
    }
    if (description.glsl_source.empty())
    {
        reject("the GLSL source is empty", "set ShaderModuleDescription::glsl_source");
    }
}

/// @brief Compiled shader code. Its layout is reflected from the SPIR-V when the module is created.
class ShaderModule : public BackendObject
{
public:
    /// @brief Handle naming this module in pipeline descriptions.
    [[nodiscard]] virtual auto handle() const noexcept -> ShaderModuleHandle = 0;

    /// @brief Stage the shader runs in.
    [[nodiscard]] virtual auto stage() const noexcept -> ShaderStage = 0;

    /// @brief Bindings, push constants, inputs, outputs and workgroup size, reflected from the SPIR-V.
    [[nodiscard]] virtual auto layout() const noexcept -> const ShaderLayout& = 0;
};

/// @brief What happened to one changed shader file (Device::poll_shader_changes(), Debug builds).
struct ShaderReload
{
    std::string shader_name{};                              ///< Name of the module.
    std::string source_path{};                              ///< File that changed.
    ShaderReloadResult result = ShaderReloadResult::RELOADED; ///< Reloaded, or why the old code stays.
    std::string message{};                                  ///< Compiler log or layout mismatch (empty when reloaded).
};

} // namespace gfx
