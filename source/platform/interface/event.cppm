/// @file event.cppm
/// @brief Normalized events: one trivially copyable value type (Event, at most MAXIMUM_EVENT_SIZE
///        bytes) whose payload is a std::variant of one struct per event category. Variable-length data
///        (typed text, IME compositions, dropped paths) lives in the text of the EventQueue that holds
///        the events, so pumping events allocates nothing in steady state.
///
/// @code
/// for (const Event& event : platform.poll_events())
/// {
///     if (const auto* key = event.get_if<KeyboardEvent>(); key != nullptr && event.type() == EventType::KEY_DOWN)
///     {
///         ...
///     }
/// }
/// @endcode
export module gfx.platform.interface:event;

import std;
import gfx.core;
import gfx.platform.enums;
import gfx.platform.handles;

export namespace gfx::platform
{

/// @brief UTF-8 text of an event: a range of the text of the EventSpan (EventQueue) holding the event.
struct TextReference
{
    std::uint32_t offset = 0; ///< First byte.
    std::uint32_t length = 0; ///< Bytes.

    constexpr bool operator==(const TextReference&) const = default;
};

// ================================================================================================= Payloads

/// @brief Window events: the size, framebuffer size, position and content scale after the event.
struct WindowEvent
{
    /// @brief Event types carrying this payload.
    static constexpr std::array TYPES{
        EventType::WINDOW_SHOWN,         EventType::WINDOW_HIDDEN,          EventType::WINDOW_EXPOSED,
        EventType::WINDOW_MOVED,         EventType::WINDOW_RESIZED,         EventType::WINDOW_FRAMEBUFFER_RESIZED,
        EventType::WINDOW_CONTENT_SCALE_CHANGED, EventType::WINDOW_MINIMIZED, EventType::WINDOW_MAXIMIZED,
        EventType::WINDOW_RESTORED,      EventType::WINDOW_FOCUS_GAINED,    EventType::WINDOW_FOCUS_LOST,
        EventType::WINDOW_OCCLUDED,      EventType::WINDOW_MOUSE_ENTERED,   EventType::WINDOW_MOUSE_LEFT,
        EventType::WINDOW_CLOSE_REQUESTED,
    };

    Extent size{};              ///< Size in window coordinates.
    Extent framebuffer_size{};  ///< Size in pixels (what swapchains use).
    Offset position{};          ///< Position on the desktop (window coordinates).
    float content_scale = 1.0F; ///< UI scale of the monitor the window is on.
};

/// @brief A key pressed or released.
struct KeyboardEvent
{
    /// @brief Event types carrying this payload.
    static constexpr std::array TYPES{EventType::KEY_DOWN, EventType::KEY_UP};

    Key key = Key::UNKNOWN;                    ///< Physical key (layout independent).
    KeyCode key_code = KeyCode::UNKNOWN;       ///< Symbol of the current layout.
    KeyModifier modifiers = KeyModifier::NONE; ///< Modifiers held.
    std::uint32_t native_scancode = 0;         ///< Scan code of the operating system (diagnostics).
    bool repeat = false;                       ///< Generated by key repeat (KEY_DOWN only).
};

/// @brief Text entered (after IME composition, if any).
struct TextInputEvent
{
    /// @brief Event types carrying this payload.
    static constexpr std::array TYPES{EventType::TEXT_INPUT};

    TextReference text{}; ///< UTF-8 text (EventSpan::text(); code_points() gives UTF-32).
};

/// @brief IME composition text being edited (not yet entered).
struct TextCompositionEvent
{
    /// @brief Event types carrying this payload.
    static constexpr std::array TYPES{EventType::TEXT_COMPOSITION};

    TextReference text{};              ///< UTF-8 composition text (empty when the composition ends).
    std::int32_t cursor = 0;           ///< Cursor position, in code points.
    std::int32_t selection_length = 0; ///< Selected code points after the cursor.
};

/// @brief The mouse moved.
struct MouseMotionEvent
{
    /// @brief Event types carrying this payload.
    static constexpr std::array TYPES{EventType::MOUSE_MOTION};

    Vector2 position{};                         ///< Cursor position in window coordinates.
    Vector2 delta{};                            ///< Motion since the previous event (relative motion when captured).
    MouseButtonMask buttons = MouseButtonMask::NONE; ///< Buttons held.
};

/// @brief A mouse button pressed or released.
struct MouseButtonEvent
{
    /// @brief Event types carrying this payload.
    static constexpr std::array TYPES{EventType::MOUSE_BUTTON_DOWN, EventType::MOUSE_BUTTON_UP};

    MouseButton button = MouseButton::LEFT; ///< Button.
    std::uint8_t click_count = 1;           ///< 1 for a single click, 2 for a double click, ...
    Vector2 position{};                     ///< Cursor position in window coordinates.
};

/// @brief The mouse wheel turned.
struct MouseWheelEvent
{
    /// @brief Event types carrying this payload.
    static constexpr std::array TYPES{EventType::MOUSE_WHEEL};

    Vector2 delta{};          ///< Precise scroll (fractions of a notch on high-resolution wheels); +y away from the user.
    std::int32_t steps_x = 0; ///< Whole notches completed horizontally by this event.
    std::int32_t steps_y = 0; ///< Whole notches completed vertically by this event.
    Vector2 position{};       ///< Cursor position in window coordinates.
    bool flipped = false;     ///< The system inverts scrolling ("natural" scrolling); delta is already as the user sees it.
};

/// @brief A gamepad connected, disconnected or remapped.
struct GamepadDeviceEvent
{
    /// @brief Event types carrying this payload.
    static constexpr std::array TYPES{EventType::GAMEPAD_CONNECTED, EventType::GAMEPAD_DISCONNECTED,
                                      EventType::GAMEPAD_REMAPPED};

    GamepadHandle gamepad{}; ///< Gamepad (stale after GAMEPAD_DISCONNECTED).
};

/// @brief A gamepad button pressed or released.
struct GamepadButtonEvent
{
    /// @brief Event types carrying this payload.
    static constexpr std::array TYPES{EventType::GAMEPAD_BUTTON_DOWN, EventType::GAMEPAD_BUTTON_UP};

    GamepadHandle gamepad{};                    ///< Gamepad.
    GamepadButton button = GamepadButton::SOUTH; ///< Button.
};

/// @brief A gamepad axis moved.
struct GamepadAxisEvent
{
    /// @brief Event types carrying this payload.
    static constexpr std::array TYPES{EventType::GAMEPAD_AXIS_MOTION};

    GamepadHandle gamepad{};                ///< Gamepad.
    GamepadAxis axis = GamepadAxis::LEFT_X; ///< Axis.
    float value = 0.0F;                     ///< Sticks in [-1, 1], triggers in [0, 1]; no dead zone applied.
};

/// @brief A finger on a gamepad touchpad.
struct GamepadTouchpadEvent
{
    /// @brief Event types carrying this payload.
    static constexpr std::array TYPES{EventType::GAMEPAD_TOUCHPAD_DOWN, EventType::GAMEPAD_TOUCHPAD_MOTION,
                                      EventType::GAMEPAD_TOUCHPAD_UP};

    GamepadHandle gamepad{};    ///< Gamepad.
    std::uint32_t touchpad = 0; ///< Touchpad of the gamepad.
    std::uint32_t finger = 0;   ///< Finger on the touchpad.
    Vector2 position{};         ///< Normalized position in [0, 1] (top left = 0, 0).
    float pressure = 0.0F;      ///< Normalized pressure in [0, 1].
};

/// @brief A joystick (a device without gamepad mapping) connected or disconnected.
struct JoystickDeviceEvent
{
    /// @brief Event types carrying this payload.
    static constexpr std::array TYPES{EventType::JOYSTICK_CONNECTED, EventType::JOYSTICK_DISCONNECTED};

    JoystickHandle joystick{}; ///< Joystick (stale after JOYSTICK_DISCONNECTED).
};

/// @brief A joystick button pressed or released.
struct JoystickButtonEvent
{
    /// @brief Event types carrying this payload.
    static constexpr std::array TYPES{EventType::JOYSTICK_BUTTON_DOWN, EventType::JOYSTICK_BUTTON_UP};

    JoystickHandle joystick{}; ///< Joystick.
    std::uint32_t button = 0;  ///< Button index.
};

/// @brief A joystick axis moved.
struct JoystickAxisEvent
{
    /// @brief Event types carrying this payload.
    static constexpr std::array TYPES{EventType::JOYSTICK_AXIS_MOTION};

    JoystickHandle joystick{}; ///< Joystick.
    std::uint32_t axis = 0;    ///< Axis index.
    float value = 0.0F;        ///< Position in [-1, 1].
};

/// @brief A joystick hat moved.
struct JoystickHatEvent
{
    /// @brief Event types carrying this payload.
    static constexpr std::array TYPES{EventType::JOYSTICK_HAT_MOTION};

    JoystickHandle joystick{};                  ///< Joystick.
    std::uint32_t hat = 0;                      ///< Hat index.
    HatPosition position = HatPosition::NONE;   ///< Directions pushed (NONE = centered).
};

/// @brief A finger on a touch device.
struct TouchEvent
{
    /// @brief Event types carrying this payload.
    static constexpr std::array TYPES{EventType::TOUCH_DOWN, EventType::TOUCH_MOTION, EventType::TOUCH_UP,
                                      EventType::TOUCH_CANCELED};

    TouchDeviceHandle device{}; ///< Touch device.
    std::uint64_t finger = 0;   ///< Finger, unique while it touches.
    Vector2 position{};         ///< Normalized position in [0, 1] (top left = 0, 0).
    Vector2 delta{};            ///< Normalized motion since the previous event.
    float pressure = 0.0F;      ///< Normalized pressure in [0, 1].
};

/// @brief A file or text dropped on a window.
struct DropEvent
{
    /// @brief Event types carrying this payload.
    static constexpr std::array TYPES{EventType::DROP_FILE, EventType::DROP_TEXT};

    TextReference text{}; ///< UTF-8 path (DROP_FILE) or text (DROP_TEXT).
    Vector2 position{};   ///< Drop position in window coordinates.
};

/// @brief A monitor connected or disconnected.
struct MonitorEvent
{
    /// @brief Event types carrying this payload.
    static constexpr std::array TYPES{EventType::MONITOR_CONNECTED, EventType::MONITOR_DISCONNECTED};

    MonitorHandle monitor{}; ///< Monitor (stale after MONITOR_DISCONNECTED).
};

/// @brief An application-wide event without data.
struct ApplicationEvent
{
    /// @brief Event types carrying this payload.
    static constexpr std::array TYPES{EventType::QUIT_REQUESTED, EventType::KEYBOARD_LAYOUT_CHANGED,
                                      EventType::CLIPBOARD_UPDATED};
};

/// @brief The payload of an event: one alternative per category (std::monostate for EventType::NONE).
using EventPayloadVariant = std::variant<std::monostate, WindowEvent, KeyboardEvent, TextInputEvent,
                                         TextCompositionEvent, MouseMotionEvent, MouseButtonEvent, MouseWheelEvent,
                                         GamepadDeviceEvent, GamepadButtonEvent, GamepadAxisEvent,
                                         GamepadTouchpadEvent, JoystickDeviceEvent, JoystickButtonEvent,
                                         JoystickAxisEvent, JoystickHatEvent, TouchEvent, DropEvent, MonitorEvent,
                                         ApplicationEvent>;

/// @brief Whether @p Payload is an alternative of @p Variant.
template<class Payload, class Variant>
inline constexpr bool IS_ALTERNATIVE_OF = false;

/// @brief Whether @p Payload is one of @p Alternatives.
template<class Payload, class... Alternatives>
inline constexpr bool IS_ALTERNATIVE_OF<Payload, std::variant<Alternatives...>> = (std::same_as<Payload, Alternatives> || ...);

/// @brief A payload of an event category (an alternative of EventPayloadVariant other than std::monostate).
template<class Payload>
concept EventPayloadType = IS_ALTERNATIVE_OF<Payload, EventPayloadVariant> && !std::same_as<Payload, std::monostate>;

/// @brief Index in EventPayloadVariant of the payload event type @p type carries.
[[nodiscard]] consteval auto
event_payload_index(EventType type) -> std::size_t
{
    // NONE carries std::monostate; every other type is listed in exactly one payload's TYPES.
    if (type == EventType::NONE)
    {
        return 0;
    }
    std::size_t found = 0;
    std::size_t matches = 0;
    [&]<std::size_t... Index>(std::index_sequence<Index...>)
    {
        const auto visit = [&]<std::size_t I>(std::integral_constant<std::size_t, I>)
        {
            using Payload = std::variant_alternative_t<I, EventPayloadVariant>;
            if constexpr (!std::same_as<Payload, std::monostate>)
            {
                for (const EventType listed : Payload::TYPES)
                {
                    if (listed == type)
                    {
                        found = I;
                        ++matches;
                    }
                }
            }
        };
        (visit(std::integral_constant<std::size_t, Index>{}), ...);
    }(std::make_index_sequence<std::variant_size_v<EventPayloadVariant>>{});

    // A constant expression cannot throw: a type without exactly one payload does not compile.
    if (matches != 1)
    {
        throw "every EventType must be listed in the TYPES of exactly one event payload";
    }
    return found;
}

/// @brief The payload type event type @p TYPE carries, e.g. EventPayload<EventType::KEY_DOWN> is KeyboardEvent.
template<EventType TYPE>
using EventPayload = std::variant_alternative_t<event_payload_index(TYPE), EventPayloadVariant>;

// ================================================================================================= Event

/// @brief A normalized event: its type, the window it concerns (null for device-level events), when it
///        happened, and its payload. Trivially copyable and at most MAXIMUM_EVENT_SIZE bytes.
class Event
{
public:
    /// @brief An event of type NONE.
    constexpr Event() noexcept = default;

    /// @brief An event of type @p TYPE concerning @p window; the payload type follows from the event
    ///        type, so they cannot disagree.
    template<EventType TYPE>
    [[nodiscard]] static constexpr auto make(WindowHandle window,
                                             std::chrono::nanoseconds timestamp,
                                             const EventPayload<TYPE>& payload) noexcept -> Event
    {
        Event event;
        event.m_type = TYPE;
        event.m_window = window;
        event.m_timestamp = timestamp.count();
        event.m_payload = payload;
        return event;
    }

    /// @brief A device-level event of type @p TYPE (no window).
    template<EventType TYPE>
    [[nodiscard]] static constexpr auto make(std::chrono::nanoseconds timestamp,
                                             const EventPayload<TYPE>& payload) noexcept -> Event
    {
        return make<TYPE>(WindowHandle{}, timestamp, payload);
    }

    /// @brief Kind of event.
    [[nodiscard]] constexpr auto type() const noexcept -> EventType
    {
        return m_type;
    }

    /// @brief Window the event concerns (null for device-level events).
    [[nodiscard]] constexpr auto window() const noexcept -> WindowHandle
    {
        return m_window;
    }

    /// @brief When it happened, on the steady clock (nanoseconds since an unspecified epoch).
    [[nodiscard]] constexpr auto timestamp() const noexcept -> std::chrono::nanoseconds
    {
        return std::chrono::nanoseconds{m_timestamp};
    }

    /// @brief The payload as @p Payload, or null when the event carries another one.
    template<EventPayloadType Payload>
    [[nodiscard]] constexpr auto get_if() const noexcept -> const Payload*
    {
        return std::get_if<Payload>(&m_payload);
    }

    /// @brief The payload as @p Payload.
    /// @throws InvalidUsageError when the event carries another payload.
    template<EventPayloadType Payload>
    [[nodiscard]] auto as(std::source_location location = std::source_location::current()) const -> const Payload&
    {
        if (const Payload* payload = get_if<Payload>())
        {
            return *payload;
        }
        throw InvalidUsageError(
            {
                .backend = std::nullopt,
                .operation = "Event::as",
                .problem = std::format("a {} event does not carry the requested payload", m_type),
                .suggestion = "test the event's type() or use get_if() first",
            },
            location);
    }

    /// @brief Calls @p visitor with the payload (std::monostate for EventType::NONE).
    template<class Visitor>
    constexpr auto visit(Visitor&& visitor) const -> decltype(auto)
    {
        return std::visit(std::forward<Visitor>(visitor), m_payload);
    }

    /// @brief The payload.
    [[nodiscard]] constexpr auto payload() const noexcept -> const EventPayloadVariant&
    {
        return m_payload;
    }

    /// @brief The text the payload references (text input, composition, drop), if it has one.
    [[nodiscard]] constexpr auto text() const noexcept -> std::optional<TextReference>
    {
        return std::visit([]<class Payload>(const Payload& payload) -> std::optional<TextReference>
        {
            if constexpr (requires { payload.text; })
            {
                return payload.text;
            }
            else
            {
                return std::nullopt;
            }
        }, m_payload);
    }

    /// @brief A copy of the event whose payload references @p text instead (events moved between queues).
    [[nodiscard]] constexpr auto with_text(TextReference text) const noexcept -> Event
    {
        Event copy = *this;
        std::visit([text]<class Payload>(Payload& payload)
        {
            if constexpr (requires { payload.text; })
            {
                payload.text = text;
            }
        }, copy.m_payload);
        return copy;
    }

private:
    EventType m_type = EventType::NONE;
    WindowHandle m_window{};
    std::int64_t m_timestamp = 0;
    EventPayloadVariant m_payload{};
};

static_assert(sizeof(Event) <= MAXIMUM_EVENT_SIZE, "events must stay small: move variable-length data to the event text");
static_assert(std::is_trivially_copyable_v<Event>);

// ================================================================================================= Text

/// @brief The code points (UTF-32) of UTF-8 text, decoded while iterating (no allocation). Malformed
///        sequences decode to U+FFFD.
class CodePoints
{
public:
    /// @brief Forward iterator over the code points.
    class Iterator
    {
    public:
        using value_type = char32_t;
        using difference_type = std::ptrdiff_t;

        constexpr Iterator() noexcept = default;

        constexpr Iterator(std::string_view text,
                           std::size_t position) noexcept
            : m_text{text}
            , m_position{position}
        {
        }

        [[nodiscard]] constexpr auto operator*() const noexcept -> char32_t
        {
            return decode().code_point;
        }

        constexpr auto operator++() noexcept -> Iterator&
        {
            m_position += decode().length;
            return *this;
        }

        constexpr auto operator++(int) noexcept -> Iterator
        {
            Iterator previous = *this;
            ++*this;
            return previous;
        }

        [[nodiscard]] constexpr bool operator==(const Iterator& other) const noexcept
        {
            return m_position == other.m_position;
        }

        /// @brief Whether the sequence at the position is well-formed UTF-8 (U+FFFD from malformed
        ///        bytes is not).
        [[nodiscard]] constexpr auto is_well_formed() const noexcept -> bool
        {
            return decode().well_formed;
        }

    private:
        /// A decoded sequence.
        struct Decoded
        {
            char32_t code_point = 0;
            std::size_t length = 1;
            bool well_formed = true;
        };

        /// The code point at the position, the bytes it takes, and whether they are well-formed.
        [[nodiscard]] constexpr auto decode() const noexcept -> Decoded
        {
            constexpr char32_t REPLACEMENT = 0xFFFD;
            const auto byte = [this](std::size_t index) -> std::uint32_t
            {
                return static_cast<std::uint8_t>(m_text[m_position + index]);
            };
            const std::size_t remaining = m_text.size() - m_position;
            const std::uint32_t lead = byte(0);

            // The sequence length the lead byte announces, and the bits it contributes.
            std::size_t length = 0;
            std::uint32_t value = 0;
            if (lead < 0x80U)
            {
                return {static_cast<char32_t>(lead), 1, true};
            }
            if ((lead & 0xE0U) == 0xC0U)
            {
                length = 2;
                value = lead & 0x1FU;
            }
            else if ((lead & 0xF0U) == 0xE0U)
            {
                length = 3;
                value = lead & 0x0FU;
            }
            else if ((lead & 0xF8U) == 0xF0U)
            {
                length = 4;
                value = lead & 0x07U;
            }
            else
            {
                return {REPLACEMENT, 1, false};
            }

            // Continuation bytes carry six bits each.
            if (remaining < length)
            {
                return {REPLACEMENT, 1, false};
            }
            for (std::size_t index = 1; index < length; ++index)
            {
                if ((byte(index) & 0xC0U) != 0x80U)
                {
                    return {REPLACEMENT, 1, false};
                }
                value = (value << 6U) | (byte(index) & 0x3FU);
            }

            // Overlong encodings, surrogates and values beyond Unicode are malformed.
            constexpr std::array<std::uint32_t, 5> SMALLEST{0, 0, 0x80U, 0x800U, 0x10000U};
            if (value < SMALLEST[length] || value > 0x10FFFFU || (value >= 0xD800U && value <= 0xDFFFU))
            {
                return {REPLACEMENT, 1, false};
            }
            return {static_cast<char32_t>(value), length, true};
        }

        std::string_view m_text;
        std::size_t m_position = 0;
    };

    /// @brief The code points of @p text (UTF-8).
    constexpr explicit CodePoints(std::string_view text) noexcept
        : m_text{text}
    {
    }

    [[nodiscard]] constexpr auto begin() const noexcept -> Iterator
    {
        return Iterator{m_text, 0};
    }

    [[nodiscard]] constexpr auto end() const noexcept -> Iterator
    {
        return Iterator{m_text, m_text.size()};
    }

private:
    std::string_view m_text;
};

/// @brief The code points of UTF-8 @p text, e.g. `for (char32_t code_point : code_points(events.text(input.text)))`.
[[nodiscard]] constexpr auto
code_points(std::string_view text) noexcept -> CodePoints
{
    return CodePoints{text};
}

/// @brief Whether @p text is well-formed UTF-8 (no truncated, overlong or surrogate sequences).
[[nodiscard]] constexpr auto
is_valid_utf8(std::string_view text) noexcept -> bool
{
    const CodePoints points{text};
    for (auto position = points.begin(); position != points.end(); ++position)
    {
        if (!position.is_well_formed())
        {
            return false;
        }
    }
    return true;
}

// ================================================================================================= Event span and queue

/// @brief The events of one pump and the text they reference. Valid until the next pump (or until
///        the EventQueue it views changes).
class EventSpan
{
public:
    /// @brief No events.
    constexpr EventSpan() noexcept = default;

    /// @brief @p events, whose TextReferences point into @p text.
    constexpr EventSpan(std::span<const Event> events,
                        std::string_view text) noexcept
        : m_events{events}
        , m_text{text}
    {
    }

    [[nodiscard]] constexpr auto begin() const noexcept
    {
        return m_events.begin();
    }

    [[nodiscard]] constexpr auto end() const noexcept
    {
        return m_events.end();
    }

    [[nodiscard]] constexpr auto size() const noexcept -> std::size_t
    {
        return m_events.size();
    }

    [[nodiscard]] constexpr auto empty() const noexcept -> bool
    {
        return m_events.empty();
    }

    [[nodiscard]] constexpr auto operator[](std::size_t index) const noexcept -> const Event&
    {
        return m_events[index];
    }

    /// @brief The events.
    [[nodiscard]] constexpr auto events() const noexcept -> std::span<const Event>
    {
        return m_events;
    }

    /// @brief The UTF-8 text @p reference names (empty when it is out of range).
    [[nodiscard]] constexpr auto text(TextReference reference) const noexcept -> std::string_view
    {
        if (static_cast<std::uint64_t>(reference.offset) + reference.length > m_text.size())
        {
            return {};
        }
        return m_text.substr(reference.offset, reference.length);
    }

    /// @brief The text of @p event (empty when its payload has none).
    [[nodiscard]] constexpr auto text(const Event& event) const noexcept -> std::string_view
    {
        const std::optional<TextReference> reference = event.text();
        return reference ? text(*reference) : std::string_view{};
    }

    /// @brief All the text of the span (what TextReferences index).
    [[nodiscard]] constexpr auto all_text() const noexcept -> std::string_view
    {
        return m_text;
    }

private:
    std::span<const Event> m_events;
    std::string_view m_text;
};

/// @brief Events and their text, reused from pump to pump: clearing keeps the memory, so a queue
///        allocates only when one pump exceeds every previous one.
class EventQueue
{
public:
    /// @brief Reserves room for @p event_capacity events and @p text_capacity bytes of text.
    explicit EventQueue(std::size_t event_capacity = DEFAULT_EVENT_QUEUE_CAPACITY,
                        std::size_t text_capacity = DEFAULT_EVENT_TEXT_CAPACITY)
    {
        m_events.reserve(event_capacity);
        m_text.reserve(text_capacity);
    }

    /// @brief Removes every event and its text (the memory stays).
    void clear() noexcept
    {
        m_events.clear();
        m_text.clear();
    }

    /// @brief Appends @p event.
    void push(const Event& event)
    {
        m_events.push_back(event);
    }

    /// @brief Appends @p event, whose payload references @p text (stored in the queue).
    void push(const Event& event,
              std::string_view text)
    {
        m_events.push_back(event.with_text(store_text(text)));
    }

    /// @brief Appends the events of @p events, with their text.
    void push(const EventSpan& events)
    {
        for (const Event& event : events)
        {
            if (event.text())
            {
                push(event, events.text(event));
            }
            else
            {
                push(event);
            }
        }
    }

    /// @brief Stores @p text and returns its reference.
    [[nodiscard]] auto store_text(std::string_view text) -> TextReference
    {
        const TextReference reference{.offset = static_cast<std::uint32_t>(m_text.size()),
                                      .length = static_cast<std::uint32_t>(text.size())};
        m_text.append(text);
        return reference;
    }

    /// @brief Removes the events @p predicate accepts (their text stays until clear()).
    template<class Predicate>
    auto remove_if(Predicate predicate) -> std::size_t
    {
        return static_cast<std::size_t>(std::erase_if(m_events, predicate));
    }

    /// @brief The events and their text.
    [[nodiscard]] auto view() const noexcept -> EventSpan
    {
        return EventSpan{m_events, m_text};
    }

    /// @brief Number of events.
    [[nodiscard]] auto size() const noexcept -> std::size_t
    {
        return m_events.size();
    }

    /// @brief Whether the queue holds no event.
    [[nodiscard]] auto empty() const noexcept -> bool
    {
        return m_events.empty();
    }

    /// @brief Events the queue holds without growing.
    [[nodiscard]] auto event_capacity() const noexcept -> std::size_t
    {
        return m_events.capacity();
    }

    /// @brief Bytes of text the queue holds without growing.
    [[nodiscard]] auto text_capacity() const noexcept -> std::size_t
    {
        return m_text.capacity();
    }

private:
    std::vector<Event> m_events;
    std::string m_text;
};

} // namespace gfx::platform
